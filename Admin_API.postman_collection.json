{
	"info": {
		"_postman_id": "admin-api-2024-sabanci",
		"name": "👨‍💼 Sabanci Admin API",
		"description": "Complete Admin API collection for the Sabanci University Internship Portal.\n\n**Admin Features:**\n- Academic term management\n- Student administration\n- Company management\n- System oversight and statistics\n- Application monitoring\n\n**Base URL:** `http://localhost:8001/backend/api/admin.php`\n\n**Usage:**\n1. Set the `base_url` environment variable\n2. Admin endpoints don't require user ID\n3. Most POST requests require JSON body data",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "admin-api"
	},
	"item": [
		{
			"name": "📅 Term Management",
			"item": [
				{
					"name": "Get All Academic Terms",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/backend/api/admin.php?action=get_terms",
							"host": ["{{base_url}}"],
							"path": ["backend", "api", "admin.php"],
							"query": [
								{"key": "action", "value": "get_terms"}
							]
						},
						"description": "Retrieves all academic terms in the system with their details and dates."
					}
				},
				{
					"name": "Add New Academic Term",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"2024-2025 Spring\",\n    \"start_date\": \"2025-02-01\",\n    \"end_date\": \"2025-06-15\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/backend/api/admin.php?action=add_term",
							"host": ["{{base_url}}"],
							"path": ["backend", "api", "admin.php"],
							"query": [
								{"key": "action", "value": "add_term"}
							]
						},
						"description": "Creates a new academic term with specified start and end dates."
					}
				},
				{
					"name": "Update Academic Term",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"term_id\": 1,\n    \"name\": \"2023-2024 Fall (Updated)\",\n    \"start_date\": \"2023-09-20\",\n    \"end_date\": \"2024-01-20\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/backend/api/admin.php?action=update_term",
							"host": ["{{base_url}}"],
							"path": ["backend", "api", "admin.php"],
							"query": [
								{"key": "action", "value": "update_term"}
							]
						},
						"description": "Updates an existing academic term's information."
					}
				},
				{
					"name": "Delete Academic Term",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"term_id\": 3\n}"
						},
						"url": {
							"raw": "{{base_url}}/backend/api/admin.php?action=delete_term",
							"host": ["{{base_url}}"],
							"path": ["backend", "api", "admin.php"],
							"query": [
								{"key": "action", "value": "delete_term"}
							]
						},
						"description": "Deletes an academic term from the system."
					}
				}
			]
		},
		{
			"name": "🎓 Student Management",
