						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"student_id\": 1,\n    \"name\": \"John Doe (Updated)\",\n    \"email\": \"john.doe.updated@student.sabanciuniv.edu\",\n    \"major\": \"Computer Engineering\",\n    \"gpa\": \"3.6\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/backend/api/admin.php?action=update_student",
